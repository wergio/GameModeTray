<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>GameModeTray</AssemblyName>
    <RootNamespace>GameModeTray</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Release builds override it with the tag: tools\publish.ps1 -Version 1.0.0 -->
    <Version>1.0.0</Version>
    <Product>GameModeTray</Product>
    <Authors>Daniele Vergini</Authors>
    <Copyright>Copyright (c) 2026 Daniele Vergini</Copyright>
    <Description>Turns on the game mode of Bluetooth headphones when they connect</Description>
    <RepositoryUrl>https://github.com/wergio/GameModeTray</RepositoryUrl>
    <!-- Keep ProductVersion equal to Version (no "+commit" suffix): code signing reads it. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- Run on a newer .NET major when 10 is not installed. -->
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <!-- Ready-made headphone profiles, offered as presets in the settings -->
    <EmbeddedResource Include="profiles\*.json" LogicalName="profiles.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
